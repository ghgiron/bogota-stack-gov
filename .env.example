# Configuración de Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bogota-stack.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bogota-stack
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bogota-stack.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Configuración de Firebase Admin SDK (Servidor)
FIREBASE_PROJECT_ID=bogota-stack
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bogota-stack.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Configuración de Inteligencia Artificial (Gemini Pro)
GEMINI_API_KEY=tu_gemini_api_key_de_google_ai_studio

